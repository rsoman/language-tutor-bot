# Copy to backend/.env for local development. Never commit .env.
# TUTOR_ENVIRONMENT is one of: local, test, prod
TUTOR_ENVIRONMENT=local
# Required, no default: a code from tutor.languages.LANGUAGES and a level that language offers
TUTOR_DEFAULT_LANGUAGE=de
TUTOR_DEFAULT_LEVEL=A1
# Added in Phase 1:
# ANTHROPIC_API_KEY=
