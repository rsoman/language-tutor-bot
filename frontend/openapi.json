{
  "openapi": "3.1.0",
  "info": {
    "title": "Language Tutor Bot",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/languages": {
      "get": {
        "summary": "Languages",
        "operationId": "languages_languages_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LanguageOut"
                  },
                  "type": "array",
                  "title": "Response Languages Languages Get"
                }
              }
            }
          }
        }
      }
    },
    "/conversations": {
      "post": {
        "tags": [
          "conversations"
        ],
        "summary": "Start Conversation",
        "description": "Starts a conversation and returns the tutor's opening message.",
        "operationId": "start_conversation_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{conversation_id}/turns": {
      "post": {
        "tags": [
          "conversations"
        ],
        "summary": "Take Turn",
        "description": "Sends the learner's message; returns feedback on it and the tutor's reply.",
        "operationId": "take_turn_conversations__conversation_id__turns_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TurnOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/words/lookup": {
      "get": {
        "tags": [
          "words"
        ],
        "summary": "Lookup Word",
        "description": "Looks up one word. 404 when nothing matches (once the logic exists).",
        "operationId": "lookup_word_words_lookup_get",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Language code from GET /languages, e.g. 'xx'",
              "title": "Language"
            },
            "description": "Language code from GET /languages, e.g. 'xx'"
          },
          {
            "name": "level",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "One of that language's levels",
              "title": "Level"
            },
            "description": "One of that language's levels"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "tags": [
          "scenarios"
        ],
        "summary": "List Scenarios",
        "description": "Scenarios at the learner's level, plus stretch scenarios at another level.",
        "operationId": "list_scenarios_scenarios_get",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Language code from GET /languages, e.g. 'xx'",
              "title": "Language"
            },
            "description": "Language code from GET /languages, e.g. 'xx'"
          },
          {
            "name": "level",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "One of that language's levels",
              "title": "Level"
            },
            "description": "One of that language's levels"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScenarioOut"
                  },
                  "title": "Response List Scenarios Scenarios Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConversationIn": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Language code from GET /languages, e.g. 'xx'"
          },
          "level": {
            "type": "string",
            "title": "Level",
            "description": "One of that language's levels"
          },
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id",
            "description": "A scenario id from GET /scenarios; none for free conversation"
          }
        },
        "type": "object",
        "required": [
          "language",
          "level"
        ],
        "title": "ConversationIn",
        "description": "Starts a conversation in one language at one of its levels."
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "opening": {
            "$ref": "#/components/schemas/TutorMessageOut"
          }
        },
        "type": "object",
        "required": [
          "id",
          "opening"
        ],
        "title": "ConversationOut"
      },
      "FeedbackOut": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "grammar_error",
              "new_word",
              "known_word",
              "unclear_word"
            ],
            "title": "Kind"
          },
          "original": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original",
            "description": "What the learner wrote"
          },
          "replacement": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement",
            "description": "What it should be"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "corrected_sentence": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SegmentOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected Sentence",
            "description": "The whole corrected sentence; joining the texts gives it"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "FeedbackOut",
        "description": "One feedback card on a learner message (D0001, D0002).\n\nWhich fields are set depends on the kind: an unclear word only has an explanation\n(the tutor's question); the others have original, replacement and corrected_sentence."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "LanguageOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "native_name": {
            "type": "string",
            "title": "Native Name"
          },
          "level_system": {
            "type": "string",
            "title": "Level System"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Levels"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "native_name",
          "level_system",
          "levels"
        ],
        "title": "LanguageOut"
      },
      "ScenarioOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Title in the learner's own language"
          },
          "native_title": {
            "type": "string",
            "title": "Native Title",
            "description": "Title in the target language"
          },
          "topics": {
            "type": "string",
            "title": "Topics",
            "description": "What the scenario practises, one short line"
          },
          "level": {
            "type": "string",
            "title": "Level",
            "description": "One of the language's levels"
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "last_result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Result",
            "description": "e.g. 'Last time: 2 corrections'"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "native_title",
          "topics",
          "level",
          "recommended",
          "done"
        ],
        "title": "ScenarioOut",
        "description": "One scenario. The client groups the flat list into sections."
      },
      "SegmentOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          }
        },
        "type": "object",
        "required": [
          "text",
          "changed"
        ],
        "title": "SegmentOut",
        "description": "A piece of the corrected sentence. Changed pieces are shown in bold (D0001)."
      },
      "TurnIn": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "TurnIn"
      },
      "TurnOut": {
        "properties": {
          "feedback": {
            "items": {
              "$ref": "#/components/schemas/FeedbackOut"
            },
            "type": "array",
            "title": "Feedback"
          },
          "reply": {
            "$ref": "#/components/schemas/TutorMessageOut"
          }
        },
        "type": "object",
        "required": [
          "feedback",
          "reply"
        ],
        "title": "TurnOut"
      },
      "TutorMessageOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "translation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Translation",
            "description": "The same message in the learner's own language"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TutorMessageOut",
        "description": "Something the tutor says, in the target language, with an optional translation."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WordFeatureOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "title": "WordFeatureOut",
        "description": "One grammatical feature the language's profile declares, e.g. a plural (D0003)."
      },
      "WordOut": {
        "properties": {
          "headword": {
            "type": "string",
            "title": "Headword",
            "description": "The word as the learner should write it"
          },
          "part_of_speech": {
            "type": "string",
            "title": "Part Of Speech"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/WordFeatureOut"
            },
            "type": "array",
            "title": "Features"
          },
          "example": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TutorMessageOut"
              },
              {
                "type": "null"
              }
            ],
            "description": "An example sentence and its translation"
          }
        },
        "type": "object",
        "required": [
          "headword",
          "part_of_speech",
          "features"
        ],
        "title": "WordOut",
        "description": "The best match for a lookup, in the target language."
      }
    }
  }
}
