{
  "openapi": "3.1.0",
  "info": {
    "title": "Language Tutor Bot",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/languages": {
      "get": {
        "summary": "Languages",
        "operationId": "languages_languages_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LanguageOut"
                  },
                  "type": "array",
                  "title": "Response Languages Languages Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "LanguageOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "native_name": {
            "type": "string",
            "title": "Native Name"
          },
          "level_system": {
            "type": "string",
            "title": "Level System"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Levels"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "native_name",
          "level_system",
          "levels"
        ],
        "title": "LanguageOut"
      }
    }
  }
}
